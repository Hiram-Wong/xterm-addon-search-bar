    "prettier": "^3.8.2",
    "rimraf": "^6.1.3",
    "rollup": "^4.60.1",
    "rollup-plugin-filesize": "^10.0.0",
    "rollup-plugin-postcss": "^4.0.2",
    "rollup-plugin-serve": "^3.0.0",
    "rollup-plugin-typescript2": "^0.37.0",
    "serve": "^14.2.6",
    "typescript": "^5.9.3"
  },
  "lint-staged": {
    "*.{js,ts}": [
